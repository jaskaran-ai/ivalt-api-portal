# Database
DATABASE_URL=postgresql://user:password@localhost:5432/ivalt_portal

# iVALT API
IVALT_API_BASE_URL=https://api.ivalt.com
IVALT_API_KEY=your_ivalt_api_key_here

# AWS API Gateway
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_API_GATEWAY_USAGE_PLAN_ID=your_usage_plan_id

# Google SMTP (for email notifications — comma-separate ADMIN_EMAIL for multiple admins)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password-here
ADMIN_EMAIL=admin@example.com

# Session
SESSION_SECRET=your_super_secret_session_key_min_32_chars_here_12345678
